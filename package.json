{
  "name": "jev-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for TypeSafe's Jev System One model: cost-aware Claude model routing plus typed judgments",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run build && tsx --test test/*.test.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "eval:routing": "tsx scripts/routing-eval.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "bin": {
    "jev-mcp-server": "dist/index.js",
    "jev-route": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  }
}
